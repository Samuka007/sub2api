# generate-env.sh replaces this with LANGFUSE_PUBLIC_URL.
NEXTAUTH_URL=GENERATE_ME
MINIO_EXTERNAL_ENDPOINT=http://minio:9000
LANGFUSE_BIND_IP=127.0.0.1
LANGFUSE_PORT=3000
TELEMETRY_ENABLED=false

# Mainland mirrors pinned to immutable multi-platform manifests.
LANGFUSE_WEB_IMAGE=docker.m.daocloud.io/langfuse/langfuse:3@sha256:775191dfcaa0d554a264aed7ee43c020da3110482b0c438682b738886429b6dd
LANGFUSE_WORKER_IMAGE=docker.m.daocloud.io/langfuse/langfuse-worker:3@sha256:224db224e894b863feae48a59c899640efd05abfced44badf95cb740aac872ee
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:17@sha256:a426e44bac0b759c95894d68e1a0ac03ecc20b619f498a91aae373bf06d8508d
CLICKHOUSE_IMAGE=docker.m.daocloud.io/clickhouse/clickhouse-server:25.12@sha256:8a790dd3468db22b1d4e7b18a176f378ff5ff6053b9c48dd4ea1fa71a24c5ba6
MINIO_IMAGE=docker.m.daocloud.io/minio/minio:RELEASE.2025-04-22T22-12-26Z@sha256:a1ea29fa28355559ef137d71fc570e508a214ec84ff8083e39bc5428980b015e
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7@sha256:595cc6f2bb3af6e03347b90deb6123c6aa2c81dea05ce08128de8a174b6ac67b
CLICKHOUSE_READ_PROXY_IMAGE=docker.m.daocloud.io/library/nginx:1.28-alpine@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236

POSTGRES_USER=langfuse
POSTGRES_DB=langfuse
CLICKHOUSE_USER=langfuse
MINIO_ROOT_USER=langfuse

# Generated by generate-env.sh. Never commit real values.
POSTGRES_PASSWORD=GENERATE_ME
CLICKHOUSE_PASSWORD=GENERATE_ME
CLICKHOUSE_READ_PASSWORD=GENERATE_ME
MINIO_ROOT_PASSWORD=GENERATE_ME
REDIS_AUTH=GENERATE_ME
SALT=GENERATE_ME
ENCRYPTION_KEY=GENERATE_64_HEX_CHARS
NEXTAUTH_SECRET=GENERATE_ME

# UI/Public API read-query protection. Requests outside these bounds are
# rejected by ClickHouse; zero cannot be used to request an unlimited value.
LANGFUSE_SKIP_FINAL_FOR_OTEL_PROJECTS=true
CLICKHOUSE_READ_MAX_CONCURRENT=8
CLICKHOUSE_READ_RATE=20
CLICKHOUSE_READ_RATE_BURST=40
CLICKHOUSE_READ_MAX_EXECUTION_SECONDS=10
CLICKHOUSE_READ_PROXY_TIMEOUT_SECONDS=12
CLICKHOUSE_READ_MAX_MEMORY_BYTES=4294967296
CLICKHOUSE_READ_MAX_MEMORY_FOR_USER_BYTES=34359738368
CLICKHOUSE_READ_MAX_ROWS=100000000
CLICKHOUSE_READ_MAX_BYTES=10000000000
CLICKHOUSE_READ_MAX_RESULT_ROWS=100000
CLICKHOUSE_READ_MAX_RESULT_BYTES=100000000
CLICKHOUSE_READ_MAX_THREADS=4
CLICKHOUSE_READ_MAX_TEMPORARY_DATA_BYTES=8589934592
CLICKHOUSE_READ_EXTERNAL_SORT_BYTES=536870912
CLICKHOUSE_READ_EXTERNAL_GROUP_BY_BYTES=536870912

# Xray VLESS Reverse + REALITY. Xray owns the primary server's public 443
# listener; unauthenticated HTTPS falls back to the main server's Caddy on
# the private host port 8443. generate-env.sh fills the secret fields and
# renders .xray/bridge.json plus main-server-xray/config.json.
XRAY_IMAGE=ghcr.nju.edu.cn/xtls/xray-core:26.5.9@sha256:933c868cbbb1ed632198c3ffeb99454709fa13dbb8c2a6f328d6a9a19e75269c
XRAY_SERVER_ADDRESS=38.244.20.220
# Public port on the main server; Docker maps it to Xray's internal 31590.
XRAY_SERVER_PORT=443
XRAY_PORTAL_BIND_IP=172.18.0.1
XRAY_PORTAL_PORT=3100
XRAY_REALITY_SERVER_NAME=api.sub2api.com
XRAY_REALITY_TARGET=host.docker.internal:8443
XRAY_UUID=
XRAY_REALITY_PRIVATE_KEY=
XRAY_REALITY_PUBLIC_KEY=
XRAY_REALITY_SHORT_ID=

LANGFUSE_INIT_ORG_ID=GENERATE_ME
LANGFUSE_INIT_ORG_NAME=Sub2API
LANGFUSE_INIT_PROJECT_ID=GENERATE_ME
LANGFUSE_INIT_PROJECT_NAME=Sub2API Model Tracing
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=GENERATE_ME
LANGFUSE_INIT_PROJECT_SECRET_KEY=GENERATE_ME
LANGFUSE_INIT_USER_EMAIL=admin@local.langfuse
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=GENERATE_ME
