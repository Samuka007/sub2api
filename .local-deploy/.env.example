# Local deployment environment example. This file has no secrets and is safe to version.
# The Quick Start in sub2api-compose.yml copies it to .env and appends freshly
# generated values for POSTGRES_PASSWORD, JWT_SECRET, and TOTP_ENCRYPTION_KEY.
# Never commit .env or copy its values into a tracked configuration file.

BIND_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release
TZ=Asia/Shanghai

# Model tracing is disabled by default. Choose langfuse or otlp_collector.
# A host-only endpoint gets the selected destination's standard path.
MODEL_TRACING_ENABLED=false
MODEL_TRACING_DESTINATION=langfuse
MODEL_TRACING_ENDPOINT=
MODEL_TRACING_PUBLIC_KEY=
MODEL_TRACING_SECRET_KEY=
